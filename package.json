{
  "name": "@treeseed-cordis/api",
  "version": "0.0.0-cordis.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./container": {
      "types": "./dist/src/container.d.ts",
      "default": "./dist/src/container.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun node_modules/@treeseed-cordis/sdk/dist/src/source-policy.js check",
    "build": "bun node_modules/@treeseed-cordis/sdk/dist/src/source-policy.js build && bun dist/src/container.js --metadata && bun dist/src/server.js --metadata",
    "test:unit": "bun test ./tests --test-name-pattern '^unit:'",
    "test:integration": "bun test ./tests --test-name-pattern '^integration:'",
    "test:smoke": "bun test ./tests --test-name-pattern '^smoke:'",
    "verify": "bun run check && bun run build && bun run test:unit && bun run test:integration && bun run test:smoke"
  },
  "peerDependencies": {
    "@treeseed-cordis/sdk": "0.0.0-cordis.4",
    "@treeseed-cordis/identity": "0.0.0-cordis.1",
    "@treeseed-cordis/admin": "0.0.0-cordis.1",
    "@treeseed-cordis/deployment": "0.0.0-cordis.4"
  },
  "devDependencies": {
    "@treeseed-cordis/sdk": "file:vendor/sdk.tgz",
    "typescript": "5.9.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "@treeseed-cordis/identity": "file:vendor/identity.tgz",
    "@treeseed-cordis/admin": "file:vendor/admin.tgz",
    "@treeseed-cordis/deployment": "file:vendor/deployment.tgz"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "jsonc-parser": "3.3.1"
  },
  "cordisCandidate": {
    "sdk": {
      "repository": "https://github.com/treeseed-ai/sdk.git",
      "commit": "c03a2b0eab89786439eddea3cff8161e85676b3e",
      "sha256": "d6d0f2f4379d2d95403a226d20899ad22a78a11ccdbb4106116ef0a925295d1b"
    },
    "identity": {
      "repository": "https://github.com/treeseed-ai/identity.git",
      "commit": "5085c1887d56daab4440c8c2b47ea712388a4393",
      "sha256": "ef75add5b4a563b1a37794c6b79fdd40cdb7d0561895f320e4e09c2556e05283"
    },
    "admin": {
      "repository": "https://github.com/treeseed-ai/admin.git",
      "commit": "6416f3741a8dbbf294e2edb757d0c57fcb182a3b",
      "sha256": "acbad5fe017601fba175e68ecab35c7d52224e9d0779bd8aeb869ca0d9d3067d"
    },
    "deployment": {
      "repository": "https://github.com/treeseed-ai/deployment.git",
      "commit": "497da1a7f07169520d95e1f78cdd07781f1fdb07",
      "sha256": "83e8b50ab068f38b7d55edf2ca1c44e478f56fdebe0a7a706d07e1e2827c48a0"
    }
  },
  "cordis": {
    "id": "node-api",
    "pluginId": "node-api",
    "capability": "container.api",
    "contractVersion": "0.3.0-cordis.1",
    "target": "deployment",
    "provide": [
      "container.api"
    ],
    "inject": [
      "deployment.engine",
      "container.database",
      "container.identity"
    ]
  },
  "cordisService": {
    "role": "api",
    "service": {
      "command": [
        "--serve",
        "--configuration",
        "/run/secrets/api-config"
      ],
      "user": "installation-owner",
      "workerSocket": true,
      "volumes": [],
      "secrets": [
        {
          "source": "api-config",
          "target": "/run/secrets/api-config"
        }
      ],
      "portTarget": null
    },
    "slots": {
      "api-config": {
        "kind": "json",
        "value": {
          "installationId": {
            "$installationId": true
          },
          "origin": {
            "$origin": ""
          },
          "issuer": {
            "$origin": "/identity/realms/cordis"
          },
          "identityInternalOrigin": "http://identity:8080",
          "clientId": "cordis-admin",
          "clientSecret": {
            "$secret": "oidc-client"
          },
          "databaseUrl": {
            "$template": [
              "postgresql://cordis:",
              {
                "$secret": "database-password"
              },
              "@database:5432/cordis"
            ]
          },
          "bootstrapSubject": {
            "$secret": "bootstrap-subject"
          },
          "workerSocket": "/run/cordis-host/worker.sock",
          "assetDigest": {
            "$assetDigest": true
          }
        }
      }
    },
    "readiness": {
      "kind": "http-json",
      "path": "/health/ready",
      "expected": {
        "ready": true,
        "installationId": {
          "$installationId": true
        },
        "assetDigest": {
          "$assetDigest": true
        },
        "nativeComposition": true
      }
    }
  },
  "cordisProviders": [
    {
      "id": "private-worker",
      "pluginId": "api",
      "capability": "api.host",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "api.host"
      ],
      "inject": []
    },
    {
      "id": "platform-operations",
      "pluginId": "api",
      "capability": "platform.invoker",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "platform.invoker"
      ],
      "inject": [
        "api.host",
        "cordis.composition"
      ]
    },
    {
      "id": "installed-routes",
      "pluginId": "api",
      "capability": "api.routes",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "api.routes"
      ],
      "inject": [
        "cordis.composition",
        "identity.sessions",
        "admin.routes",
        "platform.invoker"
      ]
    },
    {
      "id": "node-http",
      "pluginId": "api",
      "capability": "api.http",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "api.http"
      ],
      "inject": [
        "api.routes"
      ]
    }
  ]
}
