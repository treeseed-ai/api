{
  "name": "@treeseed-cordis/api",
  "version": "0.0.0-cordis.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./container": {
      "types": "./dist/src/container.d.ts",
      "default": "./dist/src/container.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bun node_modules/@treeseed-cordis/sdk/dist/src/source-policy.js check",
    "build": "bun node_modules/@treeseed-cordis/sdk/dist/src/source-policy.js build && bun dist/src/container.js --metadata && bun dist/src/server.js --metadata",
    "test:unit": "bun test ./tests --test-name-pattern '^unit:'",
    "test:integration": "bun test ./tests --test-name-pattern '^integration:'",
    "test:smoke": "bun test ./tests --test-name-pattern '^smoke:'",
    "verify": "bun run check && bun run build && bun run test:unit && bun run test:integration && bun run test:smoke"
  },
  "peerDependencies": {
    "@treeseed-cordis/sdk": "0.0.0-cordis.4",
    "@treeseed-cordis/identity": "0.0.0-cordis.1",
    "@treeseed-cordis/admin": "0.0.0-cordis.1",
    "@treeseed-cordis/deployment": "0.0.0-cordis.4"
  },
  "devDependencies": {
    "@treeseed-cordis/sdk": "file:vendor/sdk.tgz",
    "typescript": "5.9.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "@treeseed-cordis/identity": "file:vendor/identity.tgz",
    "@treeseed-cordis/admin": "file:vendor/admin.tgz",
    "@treeseed-cordis/deployment": "file:vendor/deployment.tgz"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "jsonc-parser": "3.3.1"
  },
  "cordisCandidate": {
    "sdk": {
      "repository": "https://github.com/treeseed-ai/sdk.git",
      "commit": "f44ede394a58814b5d6e73146ba9ed7246b4f2ca",
      "sha256": "16d3d7f699c55795b97972ca538bfeedeafdc6bfc4c32ed01708871ea02fe75c"
    },
    "identity": {
      "repository": "https://github.com/treeseed-ai/identity.git",
      "commit": "906d64e1dc9219786444f5f793968592bb8abd96",
      "sha256": "dd3131499b01b8ad8d4c8aa78d0cb99de69da86c4fbad1da0670439c3d8bdddc"
    },
    "admin": {
      "repository": "https://github.com/treeseed-ai/admin.git",
      "commit": "5b30c2af69c5d273936cfddd480e7f5891c75db9",
      "sha256": "a7750c6f38187e44b2823eb778f66b73c4596983226dd80c2204208f96848e28"
    },
    "deployment": {
      "repository": "https://github.com/treeseed-ai/deployment.git",
      "commit": "6a861aa81f3786b74752191b461d1bcddf99fce5",
      "sha256": "7015e2447eb4d98f9979e8f10a3b33480c8ca80818384e2cbf939eba550ab65d"
    }
  },
  "cordis": {
    "id": "node-api",
    "pluginId": "node-api",
    "capability": "container.api",
    "contractVersion": "0.3.0-cordis.1",
    "target": "deployment",
    "provide": [
      "container.api"
    ],
    "inject": [
      "deployment.engine",
      "container.database",
      "container.identity"
    ]
  },
  "cordisService": {
    "role": "api",
    "service": {
      "command": [
        "--serve",
        "--configuration",
        "/run/secrets/api-config"
      ],
      "user": "installation-owner",
      "workerSocket": true,
      "volumes": [],
      "secrets": [
        {
          "source": "api-config",
          "target": "/run/secrets/api-config"
        }
      ],
      "portTarget": null
    },
    "slots": {
      "api-config": {
        "kind": "json",
        "value": {
          "installationId": {
            "$installationId": true
          },
          "origin": {
            "$origin": ""
          },
          "issuer": {
            "$origin": "/identity/realms/cordis"
          },
          "identityInternalOrigin": "http://identity:8080",
          "clientId": "cordis-admin",
          "clientSecret": {
            "$secret": "oidc-client"
          },
          "databaseUrl": {
            "$template": [
              "postgresql://cordis:",
              {
                "$secret": "database-password"
              },
              "@database:5432/cordis"
            ]
          },
          "bootstrapSubject": {
            "$secret": "bootstrap-subject"
          },
          "workerSocket": "/run/cordis-host/worker.sock",
          "assetDigest": {
            "$assetDigest": true
          }
        }
      }
    },
    "readiness": {
      "kind": "http-json",
      "path": "/health/ready",
      "expected": {
        "ready": true,
        "installationId": {
          "$installationId": true
        },
        "assetDigest": {
          "$assetDigest": true
        },
        "nativeComposition": true
      }
    }
  },
  "cordisProviders": [
    {
      "id": "private-worker",
      "pluginId": "api",
      "capability": "api.host",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "api.host"
      ],
      "inject": []
    },
    {
      "id": "platform-operations",
      "pluginId": "api",
      "capability": "platform.invoker",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "platform.invoker"
      ],
      "inject": [
        "api.host",
        "cordis.composition"
      ]
    },
    {
      "id": "installed-routes",
      "pluginId": "api",
      "capability": "api.routes",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "api.routes"
      ],
      "inject": [
        "cordis.composition",
        "identity.sessions",
        "admin.routes",
        "platform.invoker"
      ]
    },
    {
      "id": "node-http",
      "pluginId": "api",
      "capability": "api.http",
      "contractVersion": "0.3.0-cordis.1",
      "target": "api",
      "provide": [
        "api.http"
      ],
      "inject": [
        "api.routes"
      ]
    }
  ]
}
