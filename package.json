  "cordis": {
    "id": "node-api",
    "pluginId": "node-api",
    "capability": "container.api",
    "contractVersion": "0.3.0-cordis.1",
    "target": "deployment",
    "provide": [
      "container.api"
    ],
    "inject": [
      "deployment.engine",
      "container.database",
      "container.identity"
    ]
  },
  "cordisService": {
    "role": "api",
    "service": {
      "command": [
        "--serve",
        "--configuration",
        "/run/secrets/api-config"
      ],
      "user": "installation-owner",
      "workerSocket": true,
      "volumes": [],
      "secrets": [
        {
          "source": "api-config",
          "target": "/run/secrets/api-config"
        }
      ],
      "portTarget": null
    },
    "slots": {
      "api-config": {
        "kind": "json",
        "value": {
          "installationId": {
            "$installationId": true
          },
          "origin": {
            "$origin": ""
          },
          "issuer": {
            "$origin": "/identity/realms/cordis"
          },
          "identityInternalOrigin": "http://identity:8080",
          "clientId": "cordis-admin",
          "clientSecret": {
            "$secret": "oidc-client"
          },
          "databaseUrl": {
            "$template": [
              "postgresql://cordis:",
              {
                "$secret": "database-password"
              },
              "@database:5432/cordis"
            ]
          },
          "bootstrapSubject": {
            "$secret": "bootstrap-subject"
          },
          "workerSocket": "/run/cordis-host/worker.sock",
          "assetDigest": {
            "$assetDigest": true
          }
        }
      }
    },
    "readiness": {
      "kind": "http-json",
      "path": "/health/ready",
      "expected": {
        "ready": true,
        "installationId": {
          "$installationId": true
        },
        "assetDigest": {
          "$assetDigest": true
        },
        "nativeComposition": true
      }
    }
  },
